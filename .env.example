# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================

# Render backend URL
VITE_API_URL=https://YOUR-BACKEND-NAME.onrender.com

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID


# ================================
# BACKEND ENVIRONMENT VARIABLES
# ================================

# Server
NODE_ENV=production
PORT=5001

# Frontend URL
FRONTEND_URL=https://nyayaai.online


# ================================
# DATABASE - RAILWAY MYSQL
# ================================

DB_HOST=YOUR_RAILWAY_DB_HOST
DB_PORT=3306
DB_USER=YOUR_RAILWAY_DB_USER
DB_PASSWORD=YOUR_RAILWAY_DB_PASSWORD
DB_NAME=nyaya_ai


# ================================
# AUTHENTICATION
# ================================

JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET

OTP_HASH_SECRET=YOUR_LONG_RANDOM_OTP_SECRET

ACCESS_TOKEN_TTL=15m


# ================================
# GOOGLE
# ================================

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET


# ================================
# AI SERVICES
# ================================

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

GROQ_API_KEY=YOUR_GROQ_API_KEY

SARVAM_API_KEY=YOUR_SARVAM_API_KEY

GROQ_VISION_MODEL=
GEMINI_VISION_MODEL=

OCR_LANGUAGE=eng


# ================================
# EMAIL
# ================================

RESEND_API_KEY=YOUR_RESEND_API_KEY


# ================================
# BLOCKCHAIN
# ================================

BLOCKCHAIN_ENABLED=true

BLOCKCHAIN_RPC_URL=YOUR_BLOCKCHAIN_RPC_URL

BLOCKCHAIN_NETWORK=YOUR_BLOCKCHAIN_NETWORK

BLOCKCHAIN_PRIVATE_KEY=YOUR_BLOCKCHAIN_PRIVATE_KEY

BLOCKCHAIN_TARGET_ADDRESS=YOUR_BLOCKCHAIN_TARGET_ADDRESS