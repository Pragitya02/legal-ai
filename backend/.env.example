# =====================================================
# NYAYA AI - BACKEND ENVIRONMENT VARIABLES
# =====================================================

# =====================================================
# GROQ AI
# =====================================================

GROQ_API_KEY=your_groq_api_key_here


# =====================================================
# GOOGLE / GEMINI AI
# Used for legal document vision, OCR and document
# analysis in Advocate AI Research.
# =====================================================

GEMINI_API_KEY=your_gemini_api_key_here


# =====================================================
# GOOGLE OAUTH
# =====================================================

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# =====================================================
# DATABASE
# =====================================================

DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_PORT=3306


# =====================================================
# SARVAM AI
# =====================================================

SARVAM_API_KEY=your_sarvam_api_key_here


# =====================================================
# JWT AUTHENTICATION
# =====================================================

JWT_SECRET=your_jwt_secret_here


# =====================================================
# FRONTEND / SERVER
# =====================================================

FRONTEND_URL=https://nyayaai.online
PORT=5001


# =====================================================
# BLOCKCHAIN (DOCUMENT INTEGRITY)
# Wired into the document upload route (and a retry endpoint).
# Leave BLOCKCHAIN_ENABLED unset/false to keep uploads working
# exactly as before, with no blockchain transactions attempted.
#
# NEVER commit real values for these. BLOCKCHAIN_PRIVATE_KEY
# must be a dedicated test-network wallet key only, never a
# wallet holding real funds.
# =====================================================

# Master switch. Must be exactly "true" to activate.
BLOCKCHAIN_ENABLED=false

# JSON-RPC endpoint for an EVM-compatible network, e.g. a
# Polygon Amoy testnet URL from Alchemy/Infura/public RPC.
BLOCKCHAIN_RPC_URL=your_rpc_url_here

# Private key of the backend-only signing wallet.
# NEVER exposed to the frontend or logged.
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_here

# Optional. Address the hash-anchoring transaction is sent
# to. Defaults to the wallet's own address if unset.
BLOCKCHAIN_TARGET_ADDRESS=

# Human-readable network label used only for logging/metadata.
BLOCKCHAIN_NETWORK=polygon-amoy